{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\sqlexpress;Database=OrderDb;integrated security=true;trustservercertificate=true;"
  },
  "JwtSettings": {
    "Key": "DevelopmentSuperSecretKeyThatIsAtLeast32BytesLong!",
    "Issuer": "OrderManagementAPI",
    "Audience": "OrderManagementClient",
    "DurationInMinutes": 480
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "ServiceUrls": {
    "RestaurantService": "https://localhost:6001",
    "CustomerService": "https://localhost:6002",
    "DeliveryService": "https://localhost:6003"
  }
}